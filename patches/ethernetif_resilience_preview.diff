# ---------- Hunk 1: 顶部诊断打印辅助函数 (无第三方依赖, Bootloader 安全) ----------
@@ -34,7 +34,28 @@
 /* Within 'USER CODE' section, code will be kept by default at each generation */
 /* USER CODE BEGIN 0 */
+#include <stdio.h>
+#include <stdarg.h>
+
+/* 诊断打印: 节流 1Hz, 避免 RS485 半双工串口(每字节约 2ms)刷屏。
+   Bootloader 目标未实现 __io_putchar(weak, 无默认), 必须做 NULL 检查,
+   否则 Bootloader 跑这份共享代码时会跳 NULL 崩溃。 */
+static uint32_t eth_diag_tick = 0;
+static void eth_diag_print(const char *fmt, ...)
+{
+    extern int __io_putchar(int) __attribute__((weak));
+    if ((int (*)(int))__io_putchar == 0) return;
+    uint32_t now = HAL_GetTick();
+    if (now - eth_diag_tick < 1000U) return;
+    eth_diag_tick = now;
+    char buf[96];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    printf("%s", buf);
+}
 /* USER CODE END 0 */

# ---------- Hunk 2: DP83848_Init 失败重试 (不再静默 return) ----------
@@ -218,16 +239,34 @@
   /* Set PHY IO functions */
   DP83848_RegisterBusIO(&DP83848, &DP83848_IOCtx);
 
-  /* Initialize the DP83848 ETH PHY */
-  if(DP83848_Init(&DP83848) != DP83848_STATUS_OK)
-  {
-    netif_set_link_down(netif);
-    netif_set_down(netif);
-    return;
-  }
+  /* Initialize the DP83848 ETH PHY —— 失败重试, 避免复位后 PHY 未就绪而永久掉网 */
+  {
+    int32_t phy_ret = DP83848_STATUS_ERROR;
+    for (int try = 1; try <= 5; try++)
+    {
+      phy_ret = DP83848_Init(&DP83848);
+      eth_diag_print("[PHY] Init try#%d ret=%ld DevAddr=%ld\r\n",
+                     try, (long)phy_ret, (long)DP83848.DevAddr);
+      if (phy_ret == DP83848_STATUS_OK) break;
+      HAL_Delay(100);
+    }
+    if (phy_ret != DP83848_STATUS_OK)
+    {
+      /* 彻底失败: 打印错误, 但不静默 return;
+         交给 ethernet_link_check_state 在后续周期重新扫描 DevAddr 恢复 */
+      eth_diag_print("[PHY] Init FAILED after 5 tries, ret=%ld\r\n", (long)phy_ret);
+      netif_set_link_down(netif);
+      netif_set_down(netif);
+    }
+  }

