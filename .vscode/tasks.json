{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/Debug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash Both (Bootloader + App + boot_valid)",
            "detail": "Full chip erase, then flash Bootloader.hex + App.hex + boot_valid flag via ST-LINK CLI",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/flash_both.cmd",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "dependsOn": ["Build"]
        },
        {
            "label": "Flash App Only (no erase)",
            "detail": "Flash App.bin at 0x08010000 only (Bootloader & flags preserved). NOTE: original task referenced DP83848.hex which is never generated by the build; switched to flash_app.cmd (elf->bin + fixed address).",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/flash_app.cmd",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "dependsOn": ["Build"]
        }
    ]
}
